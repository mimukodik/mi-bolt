# Rendered by the image's envsubst into /etc/nginx/conf.d/default.conf; only ${BACKEND_ORIGIN} is substituted.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # The backend owns every header on its responses (ADR 0018); no fallback under /api/.
    location ^~ /api/ {
        # gzip weakens a strong ETag to W/"n"; keep the backend's strong ETag for If-Match writes.
        gzip off;
        client_max_body_size 2m;
        proxy_pass ${BACKEND_ORIGIN};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build output never changes under the same name.
    location ~* "^/(admin/|demo-fizetes/)?(chunk|main|styles)-[A-Za-z0-9_-]{8}\.(js|css)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Any other file with an extension: revalidate, and a missing one is a 404, never index.html.
    location ~ "\.[A-Za-z0-9]+$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location /admin/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /admin/index.html;
    }

    location /demo-fizetes/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /demo-fizetes/index.html;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
