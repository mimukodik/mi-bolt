{
  "$schema": "node_modules/ng-openapi-gen/ng-openapi-gen-schema.json",
  "input": "docs/api/openapi.yaml",
  "output": "projects/admin/src/app/api/generated",
  "module": false,
  "services": false,
  "apiService": "AdminApi",
  "promises": false,
  "enumStyle": "alias",
  "enumArray": true,
  "ignoreUnusedModels": true,
  "excludeParameters": ["If-Match"],
  "includeTags": ["AdminAuth", "AdminUsers", "AdminProducts", "AdminMedia"]
}
