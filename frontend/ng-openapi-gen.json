{
  "$schema": "node_modules/ng-openapi-gen/ng-openapi-gen-schema.json",
  "input": "docs/api/openapi.yaml",
  "output": "src/app/api/generated",
  "module": false,
  "services": false,
  "apiService": "Api",
  "promises": false,
  "enumStyle": "alias",
  "enumArray": true,
  "ignoreUnusedModels": true,
  "excludeParameters": ["If-Match"],
  "excludeTags": ["AdminAuth", "AdminUsers", "AdminProducts", "AdminMedia"]
}
