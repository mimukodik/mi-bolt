{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mi-bolt.local/catalog.schema.json",
  "title": "MiBolt demo catalogue (yettel.hu import)",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "source", "products"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "allOf": [{
        "if": {
          "required": ["promotion"],
          "properties": { "promotion": { "required": ["enabled"], "properties": { "enabled": { "const": true } } } }
        },
        "then": { "properties": { "variants": { "contains": { "required": ["salePriceHuf"], "properties": { "salePriceHuf": { "type": "integer", "minimum": 1, "maximum": 100000000 } } } } } }
      }],
      "additionalProperties": false,
      "required": [
        "slug", "brand", "name", "highlights", "description",
        "is5g", "releasedAt", "rank", "popularityScore", "featured",
        "specGroups", "colors", "variants"
      ],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "brand": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "highlights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "is5g": { "type": "boolean" },
        "releasedAt": { "type": "string", "format": "date" },
        "rank": { "type": "integer", "minimum": 1 },
        "popularityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "featured": { "type": "boolean" },
        "promotion": { "$ref": "#/$defs/promotion" },
        "specGroups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/specGroup" }
        },
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/color" }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "text": { "type": "string", "maxLength": 280 },
        "startsAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "required": ["text", "startsAt", "endsAt"],
        "properties": { "text": { "minLength": 1, "pattern": "\\S" } }
      }
    },
    "specGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "rows"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/specRow" }
        }
      }
    },
    "specRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "swatchHex", "image"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "swatchHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "image": { "$ref": "#/$defs/imageRef" }
      }
    },
    "imageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "alt", "width", "height"],
      "properties": {
        "file": { "type": "string", "pattern": "^[0-9a-f]{64}\\.(webp|jpg|png)$" },
        "alt": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "colorCode", "storageGb", "priceHuf", "stock"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*--(128|256|512)$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "colorCode": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "storageGb": { "type": "integer", "enum": [128, 256, 512] },
        "priceHuf": { "type": "integer", "minimum": 0 },
        "salePriceHuf": { "type": ["integer", "null"], "minimum": 1, "maximum": 100000000 },
        "stock": { "type": "integer", "minimum": 0, "maximum": 12 }
      }
    }
  }
}
