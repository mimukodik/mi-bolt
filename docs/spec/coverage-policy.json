{
  "version": 1,
  "requireDesignSkillAt": [
    "implementation",
    "verification"
  ],
  "skill": "docs/design/yettel.md",
  "unit": {
    "thresholds": {
      "statements": 100,
      "branches": 100,
      "functions": 100,
      "lines": 100
    },
    "perFile": true,
    "include": [
      "src/**/*.ts"
    ],
    "excludeClassifications": {
      "generated": [
        "src/app/api/generated/**",
        "public/mockServiceWorker.js"
      ],
      "tests": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "tests/**"
      ],
      "typesOnly": [
        "**/*.d.ts"
      ]
    },
    "includeUnvisitedFiles": true
  },
  "forbidden": [
    "coverage-ignore pragmas",
    "skip/todo/only",
    "silent reduced thresholds",
    "deleting defensive code solely to evade meaningful behavior tests",
    "using 100% passing tests as a synonym for 100% source coverage"
  ],
  "artifactStatus": "policy-design-not-executed"
}
