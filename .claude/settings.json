{
  "permissions": {
    "ask": [
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git --no-verify *)",
      "Bash(git * --no-verify *)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(gh push)",
      "Bash(gh push:*)",
      "Bash(gh pr create)",
      "Bash(gh pr create:*)",
      "Bash(git reset --:*)",
      "Bash(git reset -- .)"
    ],
    "deny": [
      "Read(scripts/coder-agent/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start/hook.ts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-guard/hook.ts\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "capture-learnings": "off",
    "create-skill": "off",
    "context-xray": "off",
    "extension-points": "off",
    "generative-ui": "off",
    "browser-sessions": "off",
    "qa": "off",
    "writing-agent-instructions": "off"
  },
  "plansDirectory": ".claude/plans",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "feedbackDrafts": "off",
  "outputStyle": "Concise",
  "enabledMcpjsonServers": [
    "chrome-devtools",
    "angular-cli",
    "playwright-test",
    "linear-server",
    "spring-tools"
  ]
}
