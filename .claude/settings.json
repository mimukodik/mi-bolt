{
  "permissions": {
    "ask": [
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git --no-verify *)",
      "Bash(git * --no-verify *)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(gh push)",
      "Bash(gh push:*)",
      "Bash(gh pr create)",
      "Bash(gh pr create:*)",
      "Bash(git reset --:*)",
      "Bash(git reset -- .)"
    ],
    "deny": [
      "Read(scripts/coder-agent/opencode-go-eggproject-deepseek-v4.1-flash.env)",
      "Read(scripts/coder-agent/xkiro-gpt-6-luna.env)",
      "Read(scripts/coder-agent/opencode-go-3pixel-deepseek-v4.1-flash.env)",
      "Read(scripts/coder-agent/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start/hook.ts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-guard/hook.ts\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "capture-learnings": "off",
    "create-skill": "off",
    "context-xray": "off",
    "extension-points": "off",
    "generative-ui": "off",
    "browser-sessions": "off",
    "qa": "off",
    "writing-agent-instructions": "off"
  },
  "plansDirectory": ".claude/plans",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "48"
  },
  "feedbackDrafts": "off",
  "outputStyle": "Concise",
  "enabledMcpjsonServers": [
    "chrome-devtools",
    "angular-cli",
    "playwright-test",
    "linear-server",
    "spring-tools",
    "exa",
    "docmost"
  ],
  "plansDirectory": ".claude/plans",
  "enabledPlugins": {
    "framed-output@easter-skill-framed-output": true,
    "git@mi-skill-git": true,
    "docmost-design@mi-skill-docmost-design": true
  },
  "extraKnownMarketplaces": {
    "easter-skill-framed-output": {
      "source": {
        "source": "github",
        "repo": "EggProject/easter-skill-framed-output"
      }
    },
    "mi-skill-docmost-design": {
      "source": {
        "source": "github",
        "repo": "mimukodik/mi-skill-docmost-design"
      }
    },
    "mi-skill-git": {
      "source": {
        "source": "github",
        "repo": "mimukodik/mi-skill-git"
      }
    }
  }
}
