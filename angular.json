{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "mi-bolt": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles/tokens.css", "src/styles/primitives.css", "src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "local-backend": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.local-backend.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.json", "hmr": false },
          "configurations": {
            "production": {
              "buildTarget": "mi-bolt:build:production"
            },
            "development": {
              "buildTarget": "mi-bolt:build:development"
            },
            "local-backend": {
              "buildTarget": "mi-bolt:build:local-backend",
              "proxyConfig": "proxy.local-backend.conf.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "vitest.config.ts",
            "setupFiles": ["tests/setup-msw.ts"],
            "coverage": true,
            "coverageInclude": ["src/**/*.ts"],
            "coverageExclude": [
              "**/*.spec.ts",
              "**/*.test.ts",
              "**/*.d.ts",
              "src/app/api/generated/**",
              "tests/**"
            ],
            "coverageThresholds": {
              "perFile": false,
              "statements": 80,
              "branches": 75,
              "functions": 80,
              "lines": 80
            },
            "coverageReporters": ["json-summary", "json", "text"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": "eslint.config.mjs",
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "tests/**/*.ts",
              "e2e/**/*.ts",
              "playwright.config.ts"
            ]
          }
        }
      }
    },
    "demo-payment": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/demo-payment",
      "sourceRoot": "projects/demo-payment/src",
      "prefix": "pay",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/demo-payment/src/main.ts",
            "index": "projects/demo-payment/src/index.html",
            "tsConfig": "projects/demo-payment/tsconfig.app.json",
            "baseHref": "/demo-fizetes/",
            "outputPath": { "base": "dist/demo-payment" },
            "assets": [
              {
                "glob": "mockServiceWorker.js",
                "input": "public"
              }
            ],
            "styles": ["projects/demo-payment/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" },
                { "type": "anyComponentStyle", "maximumWarning": "4kB", "maximumError": "8kB" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4210,
            "servePath": "/demo-fizetes",
            "hmr": false,
            "proxyConfig": "proxy.payment.conf.json"
          },
          "configurations": {
            "production": { "buildTarget": "demo-payment:build:production" },
            "development": { "buildTarget": "demo-payment:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "projects/demo-payment/vitest.config.ts",
            "coverage": true,
            "coverageInclude": ["projects/demo-payment/src/**/*.ts"],
            "coverageExclude": ["**/*.spec.ts", "**/*.d.ts", "**/main.ts"],
            "coverageThresholds": {
              "perFile": false,
              "statements": 80,
              "branches": 75,
              "functions": 80,
              "lines": 80
            },
            "coverageReporters": ["json-summary", "json", "text"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/demo-payment/**/*.ts",
              "projects/demo-payment/**/*.html"
            ],
            "eslintConfig": "eslint.config.mjs"
          }
        }
      }
    },
    "admin": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/admin",
      "sourceRoot": "projects/admin/src",
      "prefix": "adm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/admin/src/main.ts",
            "index": "projects/admin/src/index.html",
            "tsConfig": "projects/admin/tsconfig.app.json",
            "baseHref": "/admin/",
            "outputPath": { "base": "dist/admin" },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin/public"
              }
            ],
            "styles": [
              "projects/admin/src/material-theme.scss",
              "node_modules/@fontsource/roboto/400.css",
              "node_modules/@fontsource/roboto/500.css",
              "node_modules/material-symbols/outlined.css",
              "projects/admin/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/admin/src/environments/environment.ts",
                  "with": "projects/admin/src/environments/environment.development.ts"
                }
              ]
            },
            "local-backend": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/admin/src/environments/environment.ts",
                  "with": "projects/admin/src/environments/environment.local-backend.ts"
                }
              ]
            },
            "test": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4220,
            "servePath": "/admin",
            "hmr": false
          },
          "configurations": {
            "production": {
              "buildTarget": "admin:build:production"
            },
            "development": {
              "buildTarget": "admin:build:development"
            },
            "local-backend": {
              "buildTarget": "admin:build:local-backend",
              "proxyConfig": "proxy.local-backend.conf.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "admin:build:test",
            "runnerConfig": "projects/admin/vitest.config.ts",
            "setupFiles": ["projects/admin/src/testing/setup-msw.ts"],
            "coverage": true,
            "coverageInclude": ["projects/admin/src/**/*.ts"],
            "coverageExclude": [
              "**/*.spec.ts",
              "**/*.d.ts",
              "**/main.ts",
              "projects/admin/src/app/api/generated/**",
              "projects/admin/src/testing/**"
            ],
            "coverageThresholds": {
              "perFile": false,
              "statements": 80,
              "branches": 75,
              "functions": 80,
              "lines": 80
            },
            "coverageReporters": ["json-summary", "json", "text"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/admin/**/*.ts", "projects/admin/**/*.html"],
            "eslintConfig": "eslint.config.mjs"
          }
        }
      }
    }
  }
}
