# Local-only PostgreSQL credentials for deploy/compose.yaml.
#
# The database this configures never leaves the developer machine and is not
# reachable from anywhere else, so the password below is a throwaway local
# value, not a secret. Never reuse it anywhere.
#
# deploy/compose.sh copies this file to deploy/.env on first use; that copy is
# gitignored. The backend started natively (mise run backend) uses the same
# values as its defaults (application.properties).
#
# Resulting connection URL:
#   postgresql://mi_bolt:mi_bolt_local@localhost:55433/mi_bolt

POSTGRES_DB=mi_bolt
POSTGRES_USER=mi_bolt
POSTGRES_PASSWORD=mi_bolt_local

# A second stack beside the developer's one sets these in its own environment,
# together with COMPOSE_PROJECT_NAME (defaults shown):
# MIBOLT_POSTGRES_VOLUME=mi-bolt-postgres-data
# MIBOLT_POSTGRES_PORT=55433
# MIBOLT_BACKEND_PORT=8080
# MIBOLT_WEB_PORT=4200

# Demo gate (MIM-423): the one demo user, created on the first start with an empty
# demo_user table. Defaults shown; the demo password is not a secret.
# MIBOLT_DEMO_USERNAME=MiBoltDemoUser
# MIBOLT_DEMO_PASSWORD=1MiBoltDemo1

# Synthetic checkout fixture for repeatable smoke (MIM-451). The service's
# standalone default is false; Compose enables it for local/CI smoke.
# MIBOLT_SMOKE_ENABLED=true
