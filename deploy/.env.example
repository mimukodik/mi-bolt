# Local-only Docker Postgres credentials for mi-bolt-backend.
#
# The container this configures (mi-bolt-postgres) never leaves the
# developer machine and is not reachable from anywhere else, so the password
# below is a throwaway local value, not a secret. Never reuse it anywhere.
#
# scripts/local-database-docker.sh copies this file to
# .docker-compose.local-database.env on first run; that copy is gitignored.
#
# Resulting connection URL:
#   postgresql://mi_bolt:mi_bolt_local@localhost:55433/mi_bolt

POSTGRES_DB=mi_bolt
POSTGRES_USER=mi_bolt
POSTGRES_PASSWORD=mi_bolt_local
