{
  "name": "mi-bolt",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "contract:validate": "node scripts/validate-contract.mjs",
    "api:generate": "ng-openapi-gen --config ng-openapi-gen.json",
    "api:drift": "node scripts/api-drift.mjs",
    "api:validate": "node scripts/validate-contract.mjs && node scripts/api-drift.mjs",
    "coverage:manifest": "node scripts/runtime-manifest.mjs",
    "coverage:unit:check": "node scripts/check-coverage.mjs --unit",
    "coverage:e2e:check": "node scripts/check-coverage.mjs --e2e",
    "test:unit:coverage": "vitest run --coverage"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "msw": "^2.15.0",
    "ng-openapi-gen": "^1.0.5",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  }
}
