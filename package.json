{
  "name": "mi-bolt",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:payment": "ng serve demo-payment",
    "start:local-backend": "ng serve --configuration local-backend",
    "backend:db": "\"${MIBOLT_BACKEND_DIR:-../mi-bolt-backend}/scripts/local-database-docker.sh\" start",
    "backend:db:stop": "\"${MIBOLT_BACKEND_DIR:-../mi-bolt-backend}/scripts/local-database-docker.sh\" stop",
    "backend:start": "cd \"${MIBOLT_BACKEND_DIR:-../mi-bolt-backend}\" && ./gradlew bootRun",
    "build": "ng build mi-bolt",
    "build:payment": "ng build demo-payment",
    "check:payment-boot": "node scripts/check-payment-boot.mjs",
    "build:check": "node scripts/build-check.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "e2e": "E2E_COVERAGE_GATE=1 playwright test --project=seed --project=integration-chromium-fullhd --project=integration-chromium-mobile",
    "e2e:all": "playwright test --project=seed --project='integration-*'",
    "e2e:smoke": "E2E_TARGET=local-backend playwright test --project=smoke",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "ng-openapi-gen --config ng-openapi-gen.json",
    "api:drift": "npm run api:generate && git diff --exit-code -- src/app/api/generated && test -z \"$(git ls-files --others --exclude-standard -- src/app/api/generated)\"",
    "api:sync": "node scripts/api-sync.mjs",
    "fixtures:catalog": "node scripts/build-catalog-fixture.mjs",
    "fixtures:catalog:check": "node scripts/build-catalog-fixture.mjs --check"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@apidevtools/json-schema-ref-parser": "14.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "js-yaml": "4.3.2",
    "jsdom": "^28.0.0",
    "monocart-reporter": "2.13.1",
    "msw": "^2.15.0",
    "ng-openapi-gen": "^1.0.5",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  }
}
