{
  "mcpServers": {
    "angular-cli": {
      "command": "sh",
      "args": ["-c", "cd \"${CLAUDE_PROJECT_DIR:-.}/frontend\" && exec npx -y @angular/cli mcp"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated",
        "--headless",
        "--experimental-screencast"
      ]
    },
    "playwright-test": {
      "command": "sh",
      "args": [
        "-c",
        "cd \"${CLAUDE_PROJECT_DIR:-.}/frontend\" && exec npx playwright run-test-mcp-server -c playwright.config.ts"
      ]
    },
    "spring-tools": {
      "type": "stdio",
      "command": "java",
      "args": [
        "-Xmx1024m",
        "-Djdk.util.zip.disableZip64ExtraFieldValidation=true",
        "-Dspring.config.location=classpath:/application.properties",
        "-Dspring.profiles.active=file-logging",
        "-Dlogging.file.name=${CLAUDE_PROJECT_DIR:-.}/.spring-tools/boot-ls.log",
        "-Dlogging.level.root=INFO",
        "-Dspring.ai.mcp.server.stdio=true",
        "-Dlanguageserver.enabled=false",
        "-Dspring.boot.ls.project.dir=${CLAUDE_PROJECT_DIR:-.}/backend",
        "-jar",
        "${CLAUDE_PROJECT_DIR:-.}/.spring-tools/spring-boot-language-server-standalone-exec.jar"
      ]
    }
  }
}
