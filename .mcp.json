{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec npx -y chrome-devtools-mcp@latest --user-data-dir=\"$HOME/.chrome-devtools-mcp/mi-bolt\" --chrome-arg=--restore-last-session --experimental-screencast"
      ],
      "env": {}
    }
  }
}
