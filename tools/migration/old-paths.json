{
  "frontend-config": [
    {
      "paths": ["frontend/angular.json"],
      "pattern": "\"mi-bolt\"|mi-bolt:(build|serve|test)|\"sourceRoot\": \"src\"|\"(src|public)/|\"input\": \"public\"|dist/mi-bolt"
    },
    {
      "paths": ["frontend/tsconfig.json", "frontend/tsconfig.e2e.json"],
      "pattern": "\"(\\./)?src/"
    },
    {
      "paths": ["frontend/eslint.config.mjs"],
      "pattern": "'src/|\"src/"
    },
    {
      "paths": ["frontend/playwright.config.ts", "frontend/vitest.contract.config.ts"],
      "pattern": "\\['mi-bolt'\\]|'mi-bolt': \\{|'src/|dist/mi-bolt"
    },
    {
      "paths": ["frontend/ng-openapi-gen.json", "frontend/ng-openapi-gen.admin.json"],
      "pattern": "docs/api/openapi\\.yaml|\"(\\./)?src/"
    },
    {
      "paths": ["frontend/.prettierignore"],
      "pattern": "^(src|public)/"
    }
  ],
  "frontend-scripts": [
    {
      "paths": ["frontend/package.json"],
      "pattern": "dist/mi-bolt|api-sync|api:sync|catalog-source\\.json|ng (test|build|serve) mi-bolt"
    },
    {
      "paths": ["frontend/scripts"],
      "pattern": "dist/mi-bolt|catalog-source\\.json|docs/api/openapi\\.yaml|'mi-bolt'",
      "allow": [
        "frontend/scripts/fixtures/build-clean.log",
        "frontend/scripts/fixtures/build-warn.log"
      ]
    }
  ],
  "frontend-source": [
    {
      "paths": ["frontend/projects", "frontend/tests", "frontend/e2e"],
      "pattern": "catalog-source\\.json|cwd\\(\\), 'src(/|')|docs/api/openapi\\.yaml"
    },
    {
      "paths": ["frontend/projects/storefront/src/main.spec.ts"],
      "pattern": "^ *'mi-bolt',$"
    },
    {
      "paths": ["frontend/tests", "frontend/e2e"],
      "pattern": "(\\.\\./)+src/"
    }
  ],
  "ci": [
    {
      "paths": [".github/workflows"],
      "pattern": "dist/mi-bolt|mi-bolt-backend-0\\.0\\.1-SNAPSHOT\\.jar"
    }
  ],
  "backend-build": [
    {
      "paths": ["backend/services/commerce/build.gradle"],
      "pattern": "['\"]api/openapi\\.yaml|['\"]config/pmd/"
    }
  ],
  "backend-code": [
    {
      "paths": ["backend/services/commerce/src"],
      "pattern": "Path\\.of\\(\"api/openapi\\.yaml\"\\)|mibolt\\.catalog\\.path:data/catalog"
    },
    {
      "paths": ["backend/services/commerce/scripts/smoke.sh"],
      "pattern": "ls data/catalog/"
    }
  ],
  "docs": [
    {
      "paths": [
        "README.md",
        "docs",
        "frontend/docs",
        "frontend/projects/admin/README.md",
        "backend/README.md",
        "backend/docs/02-backend.md",
        "backend/docs/04-adatbazis.md",
        "backend/docs/06-uzembe-helyezes.md",
        "contracts"
      ],
      "pattern": "docs/api/openapi\\.yaml|api-sync|api:sync|catalog-source\\.json|pr-check\\.yml|local-database-docker|demo-stack\\.sh|docker-compose\\.(local-database\\.)?yml|pnpm claude:memory|\\.\\./mi-bolt-backend|mi-bolt-backend/|00-attekintes|01-kommunikacio|03-frontend\\.md|05-backend-generator|HANDOVER\\.md|traceability\\.md|docs/tasks|npm run backend:|dist/mi-bolt/|AGENTS\\.md|\\.codex/|\\.gemini/|(^|[^/])\\.agents/",
      "allow": [
        "frontend/docs/README.md",
        "frontend/docs/design/yettel.md",
        "frontend/docs/spec/execution-rules.md"
      ]
    }
  ],
  "adr": [
    {
      "paths": ["backend/docs/decisions"],
      "pattern": "docs/api/openapi\\.yaml|api-sync|api:sync|catalog-source\\.json|pr-check\\.yml|local-database-docker|demo-stack\\.sh|docker-compose\\.(local-database\\.)?yml|pnpm claude:memory|\\.\\./mi-bolt-backend|mi-bolt-backend/|00-attekintes|01-kommunikacio|03-frontend\\.md|05-backend-generator|HANDOVER\\.md|traceability\\.md|docs/tasks|npm run backend:|dist/mi-bolt/|AGENTS\\.md|\\.codex/|\\.gemini/|(^|[^/])\\.agents/",
      "allow": [
        "backend/docs/decisions/0004-contract-validator-jacoco-gate-context-path-and-json-inclusion.md",
        "backend/docs/decisions/0007-catalogue-schema-loader-and-media-storage.md",
        "backend/docs/decisions/0012-payment-intents-idempotency-and-orders.md",
        "backend/docs/decisions/0013-postgres-smoke-job-in-ci.md",
        "backend/docs/decisions/0014-openapi-tags-and-admin-contract.md"
      ]
    }
  ],
  "claude": [
    {
      "paths": [".claude", "CLAUDE.md", ".mcp.json"],
      "pattern": "docs/api/openapi\\.yaml|api-sync|api:sync|catalog-source\\.json|pr-check\\.yml|local-database-docker|demo-stack\\.sh|docker-compose\\.(local-database\\.)?yml|pnpm claude:memory|\\.\\./mi-bolt-backend|mi-bolt-backend/|00-attekintes|01-kommunikacio|03-frontend\\.md|05-backend-generator|HANDOVER\\.md|traceability\\.md|docs/tasks|npm run backend:|dist/mi-bolt/|AGENTS\\.md|\\.codex/|\\.gemini/|(^|[^/])\\.agents/",
      "allow": [
        ".claude/agents/instructions-opus.md",
        ".claude/skills/angular-developer/references/mcp.md",
        ".claude/skills/model-routing/SKILL.md",
        ".claude/skills/model-routing/references/routing-table.md",
        ".claude/skills/retrospective/SKILL.md"
      ]
    }
  ]
}
